___TESTS___

scenarios:
- name: ChatGPT referrer returns ChatGPT
  code: |-
    mock('getReferrerUrl', 'https://chatgpt.com/');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'name', checkUtmSource: true})).isEqualTo('ChatGPT');
- name: Older ChatGPT and www hosts are recognised
  code: |-
    mock('getUrl', 'https://example.co.uk/');
    mock('getReferrerUrl', 'https://chat.openai.com/c/123');
    assertThat(runCode({output: 'name'})).isEqualTo('ChatGPT');
    mock('getReferrerUrl', 'https://www.perplexity.ai/search?q=x');
    assertThat(runCode({output: 'name'})).isEqualTo('Perplexity');
    mock('getReferrerUrl', 'https://gemini.google.com/app');
    assertThat(runCode({output: 'name'})).isEqualTo('Gemini');
- name: utm_source is used when there is no referrer
  code: |-
    mock('getReferrerUrl', '');
    mock('getUrl', 'https://example.co.uk/page?utm_source=chatgpt.com');
    assertThat(runCode({output: 'name', checkUtmSource: true})).isEqualTo('ChatGPT');
- name: utm_source is ignored when the setting is off
  code: |-
    mock('getReferrerUrl', '');
    mock('getUrl', 'https://example.co.uk/page?utm_source=chatgpt.com');
    assertThat(runCode({output: 'name', checkUtmSource: false})).isUndefined();
- name: Other referrers return undefined, or the chosen value
  code: |-
    mock('getReferrerUrl', 'https://www.google.com/');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'name', checkUtmSource: true})).isUndefined();
    assertThat(runCode({output: 'name', otherValue: '(not AI)'})).isEqualTo('(not AI)');
- name: Look-alike domains don't match
  code: |-
    mock('getReferrerUrl', 'https://notchatgpt.com/');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'name'})).isUndefined();
    mock('getReferrerUrl', 'https://chatgpt.com.example.net/');
    assertThat(runCode({output: 'name'})).isUndefined();
    mock('getReferrerUrl', 'https://help.openai.com/en/articles/1');
    assertThat(runCode({output: 'name'})).isUndefined();
    mock('getReferrerUrl', 'https://www.deepseek.com/');
    assertThat(runCode({output: 'name'})).isUndefined();
    mock('getReferrerUrl', 'https://chat.deepseek.com/a/chat');
    assertThat(runCode({output: 'name'})).isEqualTo('DeepSeek');
- name: Group label and true/false output
  code: |-
    mock('getReferrerUrl', 'https://claude.ai/chat/1');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'group'})).isEqualTo('AI assistant');
    assertThat(runCode({output: 'boolean'})).isTrue();
    mock('getReferrerUrl', 'https://bing.com/');
    assertThat(runCode({output: 'boolean'})).isFalse();
- name: Extra assistants are checked first
  code: |-
    mock('getReferrerUrl', 'https://chat.example.ai/');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'name', extraAssistants: '  chat.example.ai = Example \r\nbroken line'})).isEqualTo('Example');
- name: Referrer override is used instead of the page referrer
  code: |-
    mock('getReferrerUrl', 'https://www.google.com/');
    mock('getUrl', 'https://example.co.uk/');
    assertThat(runCode({output: 'name', referrerOverride: 'https://copilot.microsoft.com/'})).isEqualTo('Copilot');


