___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const getReferrerUrl = require('getReferrerUrl');
const getUrl = require('getUrl');
const parseUrl = require('parseUrl');
const makeString = require('makeString');
const getType = require('getType');

// The sandbox doesn't guarantee String.trim, so this removes spaces, tabs and carriage returns.
const trim = function (value) {
  const str = makeString(value);
  let start = 0;
  let end = str.length;
  while (start < end && ' \t\r'.indexOf(str.charAt(start)) > -1) start++;
  while (end > start && ' \t\r'.indexOf(str.charAt(end - 1)) > -1) end--;
  return str.slice(start, end);
};

// Hostname (or the end of one) and the assistant's name. Kept up to date by Metric Owl.
const ASSISTANTS = [
  ['chatgpt.com', 'ChatGPT'], ['chat.openai.com', 'ChatGPT'],
  ['perplexity.ai', 'Perplexity'],
  ['gemini.google.com', 'Gemini'], ['bard.google.com', 'Gemini'],
  ['copilot.microsoft.com', 'Copilot'], ['copilot.cloud.microsoft', 'Copilot'],
  ['claude.ai', 'Claude'],
  ['chat.deepseek.com', 'DeepSeek'],
  ['chat.mistral.ai', 'Mistral'],
  ['grok.com', 'Grok'],
  ['meta.ai', 'Meta AI'],
  ['you.com', 'You.com'],
  ['poe.com', 'Poe'],
  ['phind.com', 'Phind']
];

// Extra assistants from the settings, one per line as hostname=Name. They're checked first.
const list = [];
const extra = makeString(data.extraAssistants || '').split('\n');
for (let i = 0; i < extra.length; i++) {
  const parts = extra[i].split('=');
  if (parts.length === 2 && trim(parts[0]) && trim(parts[1])) list.push([trim(parts[0]).toLowerCase(), trim(parts[1])]);
}
for (let i = 0; i < ASSISTANTS.length; i++) list.push(ASSISTANTS[i]);

// A full URL or a bare hostname (utm_source=chatgpt.com) becomes a lowercase hostname.
const hostOf = function (value) {
  let v = trim(value || '').toLowerCase();
  if (!v) return '';
  if (v.indexOf('://') > -1) {
    const parsed = parseUrl(v);
    v = parsed ? parsed.hostname : '';
  }
  v = v.split('/')[0].split(':')[0];
  if (v.indexOf('www.') === 0) v = v.slice(4);
  return v;
};

const match = function (host) {
  if (!host) return undefined;
  for (let i = 0; i < list.length; i++) {
    const domain = list[i][0];
    if (host === domain || host.slice(-(domain.length + 1)) === '.' + domain) return list[i][1];
  }
  return undefined;
};

let name = match(hostOf(data.referrerOverride || getReferrerUrl()));

// ChatGPT and others add utm_source to the links they cite, which survives when the referrer doesn't.
if (!name && data.checkUtmSource) {
  const page = parseUrl(data.urlOverride || getUrl());
  let source = page && page.searchParams ? page.searchParams.utm_source : undefined;
  if (getType(source) === 'array') source = source[0];
  name = match(hostOf(source));
}

if (data.output === 'boolean') return !!name;
if (name) return data.output === 'group' ? 'AI assistant' : name;
return data.otherValue ? data.otherValue : undefined;


